{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "source", "pipeline_concurrency", "tables"],
  "properties": {
    "version": {"const": 1},
    "source": {"const": "synthetic-loyalty"},
    "pipeline_concurrency": {"type": ["integer", "null"], "minimum": 1},
    "tables": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "primary_key", "columns", "load_mode", "scd_type", "deletions"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
        "primary_key": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "columns": {"type": "object", "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,62}$"},
          "additionalProperties": {"enum": ["string", "integer"]}},
        "load_mode": {"const": "full_snapshot"},
        "scd_type": {"const": 2},
        "deletions": {"const": "reject"}
      }
    }}
  }
}

